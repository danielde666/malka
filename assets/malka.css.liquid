/* Reusable utility */
.beaded-edge {
  --bead: 14px;          /* bead diameter */
  --pitch: 18px;         /* bead-to-bead spacing */
  --color: #6b4a2f;       /* bead color */
  --offset: calc(var(--bead) * -0.5); /* pushes beads out */
  position: relative;
}

/* RIGHT edge */
.beaded-edge[data-edge="right"]::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  right: var(--offset);
  width: var(--bead);
  pointer-events: none;

  /* one bead per “tile”, repeated vertically */
  background:
    radial-gradient(circle at 50% calc(var(--bead) / 2),
      var(--color) 0 48%,
      transparent 52% 100%);
  background-size: 100% var(--pitch);
  background-repeat: repeat-y;

  /* optional: soften like “ornamental ink” */
  filter: drop-shadow(0 1px 0 rgba(0,0,0,0.12));
}

/* LEFT edge */
.beaded-edge[data-edge="left"]::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: var(--offset);
  width: var(--bead);
  pointer-events: none;

  background:
    radial-gradient(circle at 50% calc(var(--bead) / 2),
      var(--color) 0 48%,
      transparent 52% 100%);
  background-size: 100% var(--pitch);
  background-repeat: repeat-y;
}

/* TOP edge */
.beaded-edge[data-edge="top"]::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: var(--offset);
  height: var(--bead);
  pointer-events: none;

  background:
    radial-gradient(circle at calc(var(--bead) / 2) 50%,
      var(--color) 0 48%,
      transparent 52% 100%);
  background-size: var(--pitch) 100%;
  background-repeat: repeat-x;
}

/* BOTTOM edge */
.beaded-edge[data-edge="bottom"]::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: var(--offset);
  height: var(--bead);
  pointer-events: none;

  background:
    radial-gradient(circle at calc(var(--bead) / 2) 50%,
      var(--color) 0 48%,
      transparent 52% 100%);
  background-size: var(--pitch) 100%;
  background-repeat: repeat-x;




