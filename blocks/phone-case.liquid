<div
  class="
    phone-case-block
    {%- if block.settings.sticky_mobile %} phone-case-block--sticky-mobile{% endif %}
    {%- if block.settings.sticky_desktop %} phone-case-block--sticky-desktop{% endif %}
  "
  style="--sticky-offset: {{ block.settings.sticky_offset }}px;"
>
  {% render 'phone-case',
    case_product: block.settings.case_product,
    tag_product: block.settings.tag_product,
    label: block.settings.label,
    tag_label: block.settings.tag_label,
    none_label: block.settings.none_label,
    uid: block.id,
    current_section_id: section.id
  %}
</div>

{% stylesheet %}
  /* Sticky bars span to the screen edge; the offset is padding so the background has no gaps.
     When the add to cart button is sticky too, this sits directly on top of it and the button's
     top padding provides the gap between them. */
  @media screen and (max-width: 749px) {
    .phone-case-block--sticky-mobile {
      position: fixed;
      inset: auto 0 0;
      padding: var(--sticky-offset) var(--sticky-offset) calc(var(--sticky-offset) + env(safe-area-inset-bottom, 0px));
      background-color: var(--color-background);
      z-index: var(--layer-sticky);
    }

    body:has(.buy-buttons-block--sticky-mobile) .phone-case-block--sticky-mobile {
      bottom: var(--sticky-add-to-cart-height);
      padding-block-end: 0;
    }
  }

  @media screen and (min-width: 750px) {
    .phone-case-block--sticky-desktop {
      position: fixed;
      inset: auto 0 0 auto;
      width: min(calc(var(--sidebar-width) + var(--sticky-offset) * 2), 100vw);
      padding: var(--sticky-offset) var(--sticky-offset) calc(var(--sticky-offset) + env(safe-area-inset-bottom, 0px));
      background-color: var(--color-background);
      z-index: var(--layer-sticky);
    }

    body:has(.buy-buttons-block--sticky-desktop) .phone-case-block--sticky-desktop {
      bottom: var(--sticky-add-to-cart-height);
      padding-block-end: 0;
    }

    .product-details:has(.phone-case-block--sticky-desktop) {
      z-index: var(--layer-raised);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Phone case",
  "settings": [
    {
      "type": "product",
      "id": "case_product",
      "label": "Case product"
    },
    {
      "type": "product",
      "id": "tag_product",
      "label": "Tag product"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Phone case"
    },
    {
      "type": "text",
      "id": "tag_label",
      "label": "Tag option label",
      "default": "Use with existing case"
    },
    {
      "type": "text",
      "id": "none_label",
      "label": "None option label",
      "default": "Chain only"
    },
    {
      "type": "header",
      "content": "Sticky"
    },
    {
      "type": "paragraph",
      "content": "Fixes the phone case selector to the bottom of the screen, above the add to cart button when that is sticky too."
    },
    {
      "type": "checkbox",
      "id": "sticky_mobile",
      "label": "Sticky on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_desktop",
      "label": "Sticky on desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Distance from screen edge",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 5,
      "visible_if": "{{ block.settings.sticky_mobile or block.settings.sticky_desktop }}"
    }
  ],
  "presets": [
    {
      "name": "Phone case"
    }
  ]
}
{% endschema %}
